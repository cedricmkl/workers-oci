{
  "name": "@cedricmkl/workers-oci",
  "version": "0.1.0",
  "description": "Package a Cloudflare Worker and the resources it binds to as an OCI artifact.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricmkl/workers-oci.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "oci",
    "artifact",
    "terraform",
    "opentofu",
    "registry"
  ],
  "bin": {
    "workers-oci": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/worker-app.v1.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
